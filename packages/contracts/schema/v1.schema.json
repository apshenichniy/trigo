{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://trigo.local/contracts/v1.schema.json",
  "title": "TrigoV1",
  "anyOf": [
    {
      "$ref": "#/$defs/LocalDevelopmentBridge"
    },
    {
      "$ref": "#/$defs/CaptureMasterProfile"
    },
    {
      "$ref": "#/$defs/CallDocument"
    },
    {
      "$ref": "#/$defs/LegacyCallDocument"
    },
    {
      "$ref": "#/$defs/TranscriptRevision"
    },
    {
      "$ref": "#/$defs/AudioManifest"
    },
    {
      "$ref": "#/$defs/StatusResponse"
    },
    {
      "$ref": "#/$defs/CommandIdentity"
    },
    {
      "$ref": "#/$defs/ErrorEnvelope"
    },
    {
      "$ref": "#/$defs/RegisterMasterUpload"
    },
    {
      "$ref": "#/$defs/MasterUploadSession"
    },
    {
      "$ref": "#/$defs/UploadPartDescriptor"
    },
    {
      "$ref": "#/$defs/UploadPartReceipt"
    },
    {
      "$ref": "#/$defs/FinalizeMasterUpload"
    },
    {
      "$ref": "#/$defs/VerifiedMasterReceipt"
    },
    {
      "$ref": "#/$defs/RequestTranscription"
    },
    {
      "$ref": "#/$defs/AvailableTranscript"
    },
    {
      "$ref": "#/$defs/TranscriptionOperation"
    },
    {
      "$ref": "#/$defs/ReplicaReference"
    },
    {
      "$ref": "#/$defs/PublishCallReplica"
    },
    {
      "$ref": "#/$defs/ReplicaReceipt"
    },
    {
      "$ref": "#/$defs/CallDeletionMarker"
    },
    {
      "$ref": "#/$defs/CallCatalogEntry"
    },
    {
      "$ref": "#/$defs/CallCatalogPage"
    },
    {
      "$ref": "#/$defs/CallChange"
    },
    {
      "$ref": "#/$defs/CallChangesPage"
    },
    {
      "$ref": "#/$defs/CatalogTranscriptResult"
    },
    {
      "$ref": "#/$defs/TranscriptResultsPage"
    },
    {
      "$ref": "#/$defs/RequestPlayback"
    },
    {
      "$ref": "#/$defs/PlaybackManifest"
    },
    {
      "$ref": "#/$defs/PlaybackGrant"
    }
  ],
  "$defs": {
    "CanonicalUUIDv4": {
      "type": "string",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
    },
    "LocalDevelopmentBridge": {
      "type": "object",
      "properties": {
        "formatVersion": {
          "type": "number",
          "enum": [1]
        },
        "worktreeId": {
          "type": "string",
          "pattern": "^[0-9a-f]{12}$"
        },
        "namespaceId": {
          "$ref": "#/$defs/CanonicalUUIDv4"
        },
        "serverURL": {
          "type": "string",
          "pattern": "^http:\\/\\/127\\.0\\.0\\.1:[0-9]+$"
        },
        "ownerToken": {
          "type": "string",
          "pattern": "^trigo_v1_[0-9a-f]{64}$"
        }
      },
      "required": ["formatVersion", "worktreeId", "namespaceId", "serverURL", "ownerToken"],
      "additionalProperties": false
    },
    "CaptureMasterProfile": {
      "type": "object",
      "properties": {
        "schemaVersion": {
          "type": "number",
          "enum": [1]
        },
        "id": {
          "type": "string",
          "enum": ["caf-lpcm-s16le-16000-stereo-v1"]
        },
        "container": {
          "type": "string",
          "enum": ["caf"]
        },
        "contentType": {
          "type": "string",
          "enum": ["audio/x-caf"]
        },
        "codec": {
          "type": "string",
          "enum": ["pcm_s16le"]
        },
        "sampleRateHz": {
          "type": "number",
          "enum": [16000]
        },
        "bitsPerSample": {
          "type": "number",
          "enum": [16]
        },
        "interleaved": {
          "type": "boolean",
          "enum": [true]
        },
        "microphoneChannel": {
          "type": "number",
          "enum": [0]
        },
        "applicationChannel": {
          "type": "number",
          "enum": [1]
        },
        "headerBytes": {
          "type": "number",
          "enum": [68]
        },
        "headerPolicy": {
          "type": "string",
          "enum": ["immutable-indefinite-final-data-chunk"]
        },
        "maxCallDurationMs": {
          "type": "number",
          "enum": [10800000]
        },
        "maxMasterBytes": {
          "type": "number",
          "enum": [691200068]
        },
        "maxCommitDurationMs": {
          "type": "number",
          "enum": [1000]
        },
        "maxUncommittedTailMs": {
          "type": "number",
          "enum": [2000]
        },
        "indexHeaderBytes": {
          "type": "number",
          "enum": [128]
        },
        "indexRecordBytes": {
          "type": "number",
          "enum": [2120]
        },
        "maxRangeBytes": {
          "type": "number",
          "enum": [8388608]
        },
        "minimumMultipartPartBytes": {
          "type": "number",
          "enum": [5242880]
        },
        "timeline": {
          "type": "string",
          "enum": ["call-relative-integer-milliseconds"]
        },
        "nonRecordedSamples": {
          "type": "string",
          "enum": ["whole-millisecond-silence-before-persistence"]
        },
        "extractionTransform": {
          "type": "string",
          "enum": ["identity-stereo-pcm-frame-slice-v1"]
        },
        "cleanupAuthority": {
          "type": "string",
          "enum": ["durably-committed-complete-verified-server-receipt"]
        }
      },
      "required": [
        "schemaVersion",
        "id",
        "container",
        "contentType",
        "codec",
        "sampleRateHz",
        "bitsPerSample",
        "interleaved",
        "microphoneChannel",
        "applicationChannel",
        "headerBytes",
        "headerPolicy",
        "maxCallDurationMs",
        "maxMasterBytes",
        "maxCommitDurationMs",
        "maxUncommittedTailMs",
        "indexHeaderBytes",
        "indexRecordBytes",
        "maxRangeBytes",
        "minimumMultipartPartBytes",
        "timeline",
        "nonRecordedSamples",
        "extractionTransform",
        "cleanupAuthority"
      ],
      "additionalProperties": false
    },
    "ExchangeUUID": {
      "type": "string",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
    },
    "PositiveInteger": {
      "type": "integer",
      "minimum": 1,
      "maximum": 9007199254740991
    },
    "UTCDateTime": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(\\.[0-9]+)?Z$",
      "format": "date-time"
    },
    "NonNegativeInteger": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "CaptureSourceDocument": {
      "type": "object",
      "properties": {
        "applicationName": {
          "type": "string"
        },
        "bundleId": {
          "type": "string"
        },
        "processId": {
          "$ref": "#/$defs/NonNegativeInteger"
        },
        "windowId": {
          "anyOf": [
            {
              "$ref": "#/$defs/NonNegativeInteger"
            },
            {
              "type": "null"
            }
          ]
        },
        "windowTitle": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": ["applicationName", "bundleId", "processId", "windowId", "windowTitle"],
      "additionalProperties": false
    },
    "InputDevice": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string"
        },
        "name": {
          "type": "string"
        }
      },
      "required": ["id", "name"],
      "additionalProperties": false
    },
    "TrackInterval": {
      "type": "object",
      "properties": {
        "startMs": {
          "$ref": "#/$defs/NonNegativeInteger"
        },
        "endMs": {
          "$ref": "#/$defs/NonNegativeInteger"
        },
        "state": {
          "type": "string",
          "enum": ["recorded", "muted", "unavailable"]
        },
        "reason": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": ["startMs", "endMs", "state", "reason"],
      "additionalProperties": false
    },
    "AudioTrack": {
      "type": "object",
      "properties": {
        "trackId": {
          "$ref": "#/$defs/ExchangeUUID"
        },
        "role": {
          "type": "string",
          "enum": ["microphone", "application"]
        },
        "inputDevice": {
          "anyOf": [
            {
              "$ref": "#/$defs/InputDevice"
            },
            {
              "type": "null"
            }
          ]
        },
        "mediaProfileId": {
          "type": "string",
          "enum": ["trigo-call-wav-s16le-16khz-stereo-60s-v1", "caf-lpcm-s16le-16000-stereo-v1"]
        },
        "intervals": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/TrackInterval"
          }
        }
      },
      "required": ["trackId", "role", "inputDevice", "mediaProfileId", "intervals"],
      "additionalProperties": false
    },
    "SHA256Digest": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "AudioManifestReference": {
      "type": "object",
      "properties": {
        "manifestId": {
          "$ref": "#/$defs/ExchangeUUID"
        },
        "sha256": {
          "$ref": "#/$defs/SHA256Digest"
        }
      },
      "required": ["manifestId", "sha256"],
      "additionalProperties": false
    },
    "RevisionReference": {
      "type": "object",
      "properties": {
        "revisionId": {
          "$ref": "#/$defs/ExchangeUUID"
        },
        "createdAt": {
          "$ref": "#/$defs/UTCDateTime"
        },
        "sha256": {
          "$ref": "#/$defs/SHA256Digest"
        }
      },
      "required": ["revisionId", "createdAt", "sha256"],
      "additionalProperties": false
    },
    "SpeakerGroup": {
      "type": "object",
      "properties": {
        "groupId": {
          "$ref": "#/$defs/ExchangeUUID"
        },
        "displayName": {
          "type": "string",
          "pattern": "\\S"
        },
        "speakerIds": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/ExchangeUUID"
          },
          "minItems": 2
        }
      },
      "required": ["groupId", "displayName", "speakerIds"],
      "additionalProperties": false
    },
    "CallDocument": {
      "type": "object",
      "properties": {
        "schemaVersion": {
          "type": "number",
          "enum": [2]
        },
        "archiveId": {
          "$ref": "#/$defs/ExchangeUUID"
        },
        "callId": {
          "$ref": "#/$defs/ExchangeUUID"
        },
        "documentVersion": {
          "$ref": "#/$defs/PositiveInteger"
        },
        "startedAt": {
          "$ref": "#/$defs/UTCDateTime"
        },
        "endedAt": {
          "anyOf": [
            {
              "$ref": "#/$defs/UTCDateTime"
            },
            {
              "type": "null"
            }
          ]
        },
        "durationMs": {
          "anyOf": [
            {
              "$ref": "#/$defs/NonNegativeInteger"
            },
            {
              "type": "null"
            }
          ]
        },
        "captureState": {
          "type": "string",
          "enum": ["recording", "stopped", "interrupted"]
        },
        "interruptionReason": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        "source": {
          "$ref": "#/$defs/CaptureSourceDocument"
        },
        "tracks": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/AudioTrack"
          },
          "minItems": 2,
          "maxItems": 2
        },
        "audioManifest": {
          "anyOf": [
            {
              "$ref": "#/$defs/AudioManifestReference"
            },
            {
              "type": "null"
            }
          ]
        },
        "revisions": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/RevisionReference"
          }
        },
        "activeRevisionId": {
          "anyOf": [
            {
              "$ref": "#/$defs/ExchangeUUID"
            },
            {
              "type": "null"
            }
          ]
        },
        "speakerNames": {
          "type": "object",
          "additionalProperties": {
            "type": "object",
            "additionalProperties": {
              "type": "string"
            },
            "propertyNames": {
              "$ref": "#/$defs/ExchangeUUID"
            }
          },
          "propertyNames": {
            "$ref": "#/$defs/ExchangeUUID"
          }
        },
        "speakerGroups": {
          "type": "object",
          "additionalProperties": {
            "type": "array",
            "items": {
              "$ref": "#/$defs/SpeakerGroup"
            }
          },
          "propertyNames": {
            "$ref": "#/$defs/ExchangeUUID"
          }
        }
      },
      "required": [
        "schemaVersion",
        "archiveId",
        "callId",
        "documentVersion",
        "startedAt",
        "endedAt",
        "durationMs",
        "captureState",
        "interruptionReason",
        "source",
        "tracks",
        "audioManifest",
        "revisions",
        "activeRevisionId",
        "speakerNames",
        "speakerGroups"
      ],
      "additionalProperties": false
    },
    "LegacyCallDocument": {
      "type": "object",
      "properties": {
        "schemaVersion": {
          "type": "number",
          "enum": [1]
        },
        "archiveId": {
          "$ref": "#/$defs/ExchangeUUID"
        },
        "callId": {
          "$ref": "#/$defs/ExchangeUUID"
        },
        "documentVersion": {
          "$ref": "#/$defs/PositiveInteger"
        },
        "startedAt": {
          "$ref": "#/$defs/UTCDateTime"
        },
        "endedAt": {
          "anyOf": [
            {
              "$ref": "#/$defs/UTCDateTime"
            },
            {
              "type": "null"
            }
          ]
        },
        "durationMs": {
          "anyOf": [
            {
              "$ref": "#/$defs/NonNegativeInteger"
            },
            {
              "type": "null"
            }
          ]
        },
        "captureState": {
          "type": "string",
          "enum": ["recording", "stopped", "interrupted"]
        },
        "interruptionReason": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        "source": {
          "$ref": "#/$defs/CaptureSourceDocument"
        },
        "tracks": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/AudioTrack"
          },
          "minItems": 2,
          "maxItems": 2
        },
        "audioManifest": {
          "anyOf": [
            {
              "$ref": "#/$defs/AudioManifestReference"
            },
            {
              "type": "null"
            }
          ]
        },
        "revisions": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/RevisionReference"
          }
        },
        "activeRevisionId": {
          "anyOf": [
            {
              "$ref": "#/$defs/ExchangeUUID"
            },
            {
              "type": "null"
            }
          ]
        },
        "speakerNames": {
          "type": "object",
          "additionalProperties": {
            "type": "object",
            "additionalProperties": {
              "type": "string"
            },
            "propertyNames": {
              "$ref": "#/$defs/ExchangeUUID"
            }
          },
          "propertyNames": {
            "$ref": "#/$defs/ExchangeUUID"
          }
        }
      },
      "required": [
        "schemaVersion",
        "archiveId",
        "callId",
        "documentVersion",
        "startedAt",
        "endedAt",
        "durationMs",
        "captureState",
        "interruptionReason",
        "source",
        "tracks",
        "audioManifest",
        "revisions",
        "activeRevisionId",
        "speakerNames"
      ],
      "additionalProperties": false
    },
    "ProviderOption": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "number"
        },
        {
          "type": "boolean"
        },
        {
          "type": "null"
        }
      ]
    },
    "ASRMetadata": {
      "type": "object",
      "properties": {
        "adapter": {
          "type": "string"
        },
        "model": {
          "type": "string"
        },
        "profileId": {
          "type": "string",
          "enum": [
            "trigo-call-wav-s16le-16khz-stereo-60s-v1",
            "nova3-wav-s16le-16000-stereo-stream-v1"
          ]
        },
        "requestedLanguage": {
          "type": "string"
        },
        "detectedLanguages": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "effectiveOptions": {
          "type": "object",
          "additionalProperties": {
            "$ref": "#/$defs/ProviderOption"
          }
        },
        "returnedModelVersion": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        "providerRequestIds": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "required": [
        "adapter",
        "model",
        "profileId",
        "requestedLanguage",
        "detectedLanguages",
        "effectiveOptions",
        "returnedModelVersion",
        "providerRequestIds"
      ],
      "additionalProperties": false
    },
    "Speaker": {
      "type": "object",
      "properties": {
        "speakerId": {
          "$ref": "#/$defs/ExchangeUUID"
        },
        "trackId": {
          "$ref": "#/$defs/ExchangeUUID"
        },
        "diarizationScopeId": {
          "$ref": "#/$defs/ExchangeUUID"
        },
        "providerLabel": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": ["speakerId", "trackId", "diarizationScopeId", "providerLabel"],
      "additionalProperties": false
    },
    "Word": {
      "type": "object",
      "properties": {
        "text": {
          "type": "string"
        },
        "startMs": {
          "$ref": "#/$defs/NonNegativeInteger"
        },
        "endMs": {
          "$ref": "#/$defs/NonNegativeInteger"
        },
        "confidence": {
          "anyOf": [
            {
              "type": "number",
              "minimum": 0,
              "maximum": 1
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": ["text", "startMs", "endMs", "confidence"],
      "additionalProperties": false
    },
    "Turn": {
      "type": "object",
      "properties": {
        "turnId": {
          "$ref": "#/$defs/ExchangeUUID"
        },
        "trackId": {
          "$ref": "#/$defs/ExchangeUUID"
        },
        "speakerId": {
          "anyOf": [
            {
              "$ref": "#/$defs/ExchangeUUID"
            },
            {
              "type": "null"
            }
          ]
        },
        "startMs": {
          "$ref": "#/$defs/NonNegativeInteger"
        },
        "endMs": {
          "$ref": "#/$defs/NonNegativeInteger"
        },
        "text": {
          "type": "string"
        },
        "words": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Word"
          }
        }
      },
      "required": ["turnId", "trackId", "speakerId", "startMs", "endMs", "text", "words"],
      "additionalProperties": false
    },
    "TranscriptRevision": {
      "type": "object",
      "properties": {
        "schemaVersion": {
          "type": "number",
          "enum": [1]
        },
        "callId": {
          "$ref": "#/$defs/ExchangeUUID"
        },
        "revisionId": {
          "$ref": "#/$defs/ExchangeUUID"
        },
        "createdAt": {
          "$ref": "#/$defs/UTCDateTime"
        },
        "audioManifest": {
          "$ref": "#/$defs/AudioManifestReference"
        },
        "normalizationVersion": {
          "type": "number",
          "enum": [1]
        },
        "asr": {
          "$ref": "#/$defs/ASRMetadata"
        },
        "speakers": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Speaker"
          }
        },
        "turns": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Turn"
          }
        }
      },
      "required": [
        "schemaVersion",
        "callId",
        "revisionId",
        "createdAt",
        "audioManifest",
        "normalizationVersion",
        "asr",
        "speakers",
        "turns"
      ],
      "additionalProperties": false
    },
    "ChannelMapping": {
      "type": "object",
      "properties": {
        "channelIndex": {
          "$ref": "#/$defs/NonNegativeInteger"
        },
        "trackId": {
          "$ref": "#/$defs/ExchangeUUID"
        }
      },
      "required": ["channelIndex", "trackId"],
      "additionalProperties": false
    },
    "AudioObject": {
      "type": "object",
      "properties": {
        "objectId": {
          "$ref": "#/$defs/ExchangeUUID"
        },
        "index": {
          "$ref": "#/$defs/NonNegativeInteger"
        },
        "contentType": {
          "type": "string",
          "enum": ["audio/wav", "audio/x-caf"]
        },
        "byteLength": {
          "$ref": "#/$defs/PositiveInteger"
        },
        "sha256": {
          "$ref": "#/$defs/SHA256Digest"
        },
        "startMs": {
          "$ref": "#/$defs/NonNegativeInteger"
        },
        "endMs": {
          "$ref": "#/$defs/NonNegativeInteger"
        },
        "channelMap": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/ChannelMapping"
          },
          "minItems": 1
        }
      },
      "required": [
        "objectId",
        "index",
        "contentType",
        "byteLength",
        "sha256",
        "startMs",
        "endMs",
        "channelMap"
      ],
      "additionalProperties": false
    },
    "AudioManifest": {
      "type": "object",
      "properties": {
        "schemaVersion": {
          "type": "number",
          "enum": [1]
        },
        "callId": {
          "$ref": "#/$defs/ExchangeUUID"
        },
        "manifestId": {
          "$ref": "#/$defs/ExchangeUUID"
        },
        "durationMs": {
          "$ref": "#/$defs/NonNegativeInteger"
        },
        "mediaProfileId": {
          "type": "string",
