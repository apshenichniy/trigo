{
  "$schema": "./node_modules/@effect/tsgo/oxlint-schema.json",
  "extends": ["./node_modules/@effect/tsgo/oxlint-presets/recommended.json"],
  "rules": {
    "curly": ["error", "all"],
    "no-duplicate-imports": ["error", { "allowSeparateTypeImports": true }],
    "no-else-return": ["error", { "allowElseIf": false }]
  },
  "overrides": [
    {
      "files": ["apps/server/src/**/*.ts", "packages/contracts/src/**/*.ts"],
      "rules": {
        "max-depth": ["error", 4],
        "no-nested-ternary": "error"
      }
    },
    {
      "files": ["scripts/**/*.ts"],
      "rules": {
        "effecttsgo/global-console": "off",
        "effecttsgo/node-builtin-import": "off",
        "effecttsgo/process-env": "off"
      }
    },
    {
      "files": [
        "scripts/commands.ts",
        "scripts/commands.test.ts",
        "scripts/local.ts",
        "scripts/timing.ts",
        "scripts/verify-push.ts",
        "scripts/verify-push.test.ts"
      ],
      "rules": {
        "effecttsgo/async-function": "off"
      }
    },
    {
      "files": ["scripts/commands.test.ts", "scripts/local.ts", "scripts/verify-push.ts"],
      "rules": {
        "effecttsgo/new-promise": "off"
      }
    },
    {
      "files": ["scripts/verify-push.ts"],
      "rules": {
        "effecttsgo/global-date": "off"
      }
    },
    {
      "files": ["scripts/local.ts"],
      "rules": {
        "effecttsgo/global-fetch": "off",
        "effecttsgo/global-timers": "off"
      }
    },
    {
      "files": ["packages/contracts/src/**/*.ts"],
      "rules": {
        "effecttsgo/async-function": "off"
      }
    },
    {
      "files": ["packages/contracts/test/**/*.ts"],
      "rules": {
        "effecttsgo/async-function": "off",
        "effecttsgo/node-builtin-import": "off"
      }
    },
    {
      "files": ["apps/server/test/**/*.worker.test.ts"],
      "rules": {
        "effecttsgo/async-function": "off",
        "effecttsgo/global-fetch": "off"
      }
    }
  ]
}
