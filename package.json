{
  "name": "trigo",
  "private": true,
  "workspaces": [
    "apps/server",
    "packages/contracts",
    "infra"
  ],
  "type": "module",
  "scripts": {
    "doctor": "bun scripts/commands.ts doctor",
    "format": "bun scripts/commands.ts format",
    "format:check": "bun scripts/commands.ts format:check",
    "lint": "bun scripts/commands.ts lint",
    "typecheck": "bun scripts/commands.ts typecheck",
    "test": "bun scripts/commands.ts test",
    "build": "bun scripts/commands.ts build",
    "check": "bun scripts/commands.ts check",
    "check:server": "bun scripts/commands.ts check:server",
    "check:macos": "bun scripts/commands.ts check:macos",
    "check:quick": "bun scripts/commands.ts check:quick",
    "check:files": "bun scripts/commands.ts check:files",
    "check:macos:smoke": "bun scripts/commands.ts check:macos:smoke",
    "test:native": "bun scripts/commands.ts test:native",
    "dev": "bun scripts/local.ts",
    "macos:run": "bun scripts/macos.ts run",
    "macos:install": "bun scripts/macos.ts install",
    "macos:archive": "bun scripts/macos.ts archive",
    "macos:build": "bun scripts/macos.ts build",
    "macos:setup": "bun scripts/macos.ts setup",
    "macos:dependencies": "bun scripts/macos.ts dependencies",
    "contracts:generate": "bun scripts/generate.ts",
    "contracts:check": "bun scripts/generate.ts --check",
    "test:unit": "node node_modules/vitest/vitest.mjs run --config vitest.config.ts",
    "test:workers": "node node_modules/vitest/vitest.mjs run --config apps/server/vitest.config.ts",
    "test:local": "bun scripts/local.ts --test",
    "cloud:preflight": "bun scripts/cloud.ts preflight",
    "cloud:bootstrap": "bun scripts/cloud.ts bootstrap",
    "cloud:deploy": "bun scripts/cloud.ts deploy",
    "cloud:owner:init": "bun scripts/cloud-owner.ts initialize",
    "cloud:owner:rotate": "bun scripts/cloud-owner.ts rotate",
    "cloud:owner:revoke": "bun scripts/cloud-owner.ts revoke",
    "test:cloud": "bun scripts/cloud.ts test",
    "test:asr": "bun scripts/asr.ts probe",
    "prepare": "effect-tsgo patch --typescript --oxlint"
  },
  "devDependencies": {
    "@cloudflare/vitest-pool-workers": "0.22.0",
    "@cloudflare/workers-types": "5.20260815.1",
    "@effect/tsgo": "0.41.0",
    "@effect/vitest": "4.0.0-rc.112",
    "@types/bun": "1.3.13",
    "@types/node": "24.3.0",
    "ajv": "8.20.0",
    "ajv-formats": "3.0.1",
    "effect": "4.0.0-rc.112",
    "oxfmt": "0.66.0",
    "oxlint": "1.81.0",
    "oxlint-tsgolint": "7.0.2001",
    "typescript": "7.0.2",
    "vite": "8.0.7",
    "vitest": "4.1.11",
    "wrangler": "4.124.0"
  },
  "packageManager": "bun@1.3.13"
}
